# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit actual tokens — .env.local is already excluded via .gitignore's `.env*.local` rule.

# Public Mapbox access token (pk....) — used at runtime by the app. Mapbox's public tokens are
# designed to ship in client bundles; find/create one at https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# Secret Mapbox download token (sk.... with the DOWNLOADS:READ scope) — used only at build time
# to fetch the native Mapbox SDK, never bundled into the app. Keep this one truly secret. Read
# directly by the @rnmapbox/maps config plugin (this exact env var name is its own convention).
# Create it at https://account.mapbox.com/access-tokens/ (Secret token, Downloads:Read scope).
# For EAS Build (cloud builds have no access to this file), also set it as an EAS secret:
#   eas secret:create --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --value <token> --type string
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Google Places API key — used only by scripts/fetch-google-ratings.ts (never bundled into the app). Create it in Google Cloud
# Console → APIs & Services → Credentials, enable "Places API (New)", and restrict the key to that API.
GOOGLE_PLACES_API_KEY=...

# Apify API token — used only by scripts/curation/gather-photo-candidates.py for its Google Images search (the
# johnvc/google-images-api actor, about $0.10 per 1,000 images). Apify Console → Settings → API & Integrations.
APIFY_TOKEN=
